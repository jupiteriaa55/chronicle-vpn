# Telegram
BOT_TOKEN=                              # from @BotFather
BOT_ADMIN_IDS=                          # comma-separated TG user IDs (admin commands)

# WireGuard server (the box that runs `wg-quick up wg0`)
WG_SERVER_HOST=                         # e.g. vpn.example.com or public IPv4
WG_SERVER_PORT=51820
WG_SERVER_PUBKEY=                       # base64 server public key
WG_INTERFACE=wg0
WG_NETWORK=10.13.13.0/24                # peers allocated from this subnet
WG_DNS=1.1.1.1, 8.8.8.8
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
WG_PEER_KEEPALIVE=25
# Path to wg config file the bot will rewrite. Mount-shared with the WG host.
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
# How the bot reloads WireGuard after writing config:
#   "wg-quick"  -> calls `wg-quick strip` + `wg syncconf` (run as root, on same host)
#   "ssh"       -> ssh root@$WG_SERVER_HOST and run reload there
#   "noop"      -> just write config, you reload manually (dev mode)
WG_RELOAD_MODE=wg-quick
WG_SSH_USER=root
WG_SSH_PORT=22
WG_SSH_KEY=/run/secrets/ssh_id_ed25519

# Trial & subscription
TRIAL_DAYS=3
SUBSCRIPTION_PRICE_STARS=150            # Telegram Stars price for 30 days
SUBSCRIPTION_PRICE_RUB=199              # YooKassa RUB price for 30 days
SUBSCRIPTION_PRICE_USD=2.49             # CryptoBot USDT price for 30 days
SUBSCRIPTION_DAYS=30

# YooKassa (https://yookassa.ru/my)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot

# CryptoBot (@CryptoBot -> Crypto Pay -> Create App)
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false

# Webhook server (for YooKassa + CryptoBot callbacks)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
WEBHOOK_PUBLIC_URL=                     # e.g. https://vpn.example.com  (must be HTTPS for production)

# Storage
DB_PATH=./data/vpn-bot.db
